# PHPStan settings. Run with: vendor/bin/phpstan
includes:
    # programster/collections' rule, which reports writes to readonly collections with array syntax where they're
    # written, rather than when they throw.
    - vendor/programster/collections/extension.neon

parameters:
    level: 10
    phpVersion:
        min: 80200
        max: 80599
    paths:
        - src
        - testing
    ignoreErrors:
        # Accessors are one line, with no docblock, so these can't say what their arrays hold. Their properties' @var
        # does instead.
        -
            identifier: missingType.iterableValue
            path: src/sets/PortSet.php
            count: 1
        -
            identifier: missingType.iterableValue
            path: src/tables/Flowtable.php
            count: 1
        -
            identifier: missingType.iterableValue
            path: testing/SmokeTestRunner.php
            count: 2
        # These tests deliberately pass the wrong type, to check that PHP rejects it when the code runs.
        -
            identifier: argument.type
            path: testing/tests/RulesetTest.php
            count: 1
        -
            identifier: argument.type
            path: testing/tests/ValidationTest.php
            count: 3
        # This test deliberately writes to readonly collections with array syntax, to check that it throws when the
        # code runs, as well as being reported by the rule.
        -
            identifier: collections.readonlyWrite
            path: testing/tests/RulesetTest.php
            count: 2
